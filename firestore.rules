rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){ return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
      match /devices/{id}{ allow read: if signedIn() && (request.auth.uid == uid || isAdmin()); allow write: if signedIn() && request.auth.uid == uid; }
    }
    match /coupons/{id}{ allow read: if signedIn(); allow write: if isAdmin(); }
    match /couponClaims/{id}{ allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if signedIn() && resource.data.userId == request.auth.uid; allow delete: if isAdmin(); }
    match /mural/{id}{ allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update,delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); }
    match /messages/{id}{ allow read: if signedIn() && (resource.data.targetUid == request.auth.uid || resource.data.targetUid == 'all' || isAdmin()); allow write: if isAdmin(); }
    match /messageReads/{id}{ allow read,create,update,delete: if signedIn(); }
  }
}